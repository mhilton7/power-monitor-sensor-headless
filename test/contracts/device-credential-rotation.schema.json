{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhilton7/power-monitor-sensor-headless/test/contracts/device-credential-rotation.schema.json",
  "title": "PowerMeter credential rotation contract vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema", "commands", "results", "authentication", "recovery"],
  "properties": {
    "contract_id": {"const": "pm-credential-rotation-contract/1.0.0"},
    "schema": {"const": "pm-credential-rotation/1.0.0"},
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/command"}
    },
    "results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/result"}
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare_command", "prepare_result", "commit_command", "commit_result", "cancel_command", "cancel_result"],
      "properties": {
        "prepare_command": {"const": "old_server_to_device"},
        "prepare_result": {"const": "old_device_to_server"},
        "commit_command": {"const": "old_server_to_device"},
        "commit_result": {"const": "new_device_to_server"},
        "cancel_command": {"const": "old_server_to_device"},
        "cancel_result": {"const": "old_device_to_server"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepared_candidate", "untrusted_time", "commit_intent", "result_cleanup"],
      "properties": {
        "prepared_candidate": {"const": "persist_and_resume"},
        "untrusted_time": {"const": "dormant_fail_closed"},
        "commit_intent": {"const": "resume_activation"},
        "result_cleanup": {"const": "authenticated_result_ack_required"}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "command_type", "not_before", "expires_at", "attempt", "idempotency_key", "required_firmware_capability", "payload"],
      "properties": {
        "command_id": {"$ref": "#/$defs/uuid"},
        "command_type": {"const": "rotate_device_credentials"},
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 255},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 100},
        "required_firmware_capability": {"const": "credential_rotation_v1"},
        "payload": {
          "oneOf": [
            {"$ref": "#/$defs/preparePayload"},
            {"$ref": "#/$defs/commitPayload"},
            {"$ref": "#/$defs/cancelPayload"}
          ]
        }
      }
    },
    "command": {"$ref": "#/$defs/baseCommand"},
    "preparePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "rotation_id", "device_secret_hex", "credential_fingerprint", "overlap_expires_at"],
      "properties": {
        "schema": {"const": "pm-credential-rotation/1.0.0"},
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "device_secret_hex": {"$ref": "#/$defs/fingerprint"},
        "credential_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "overlap_expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "commitPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "rotation_id", "credential_fingerprint"],
      "properties": {
        "schema": {"const": "pm-credential-rotation/1.0.0"},
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "credential_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "cancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "rotation_id", "cancelled"],
      "properties": {
        "schema": {"const": "pm-credential-rotation/1.0.0"},
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "cancelled": {"const": true}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "state", "progress_percent", "result_code", "evidence"],
      "properties": {
        "command_id": {"$ref": "#/$defs/uuid"},
        "state": {"const": "succeeded"},
        "progress_percent": {"const": 100},
        "result_code": {"const": "ok"},
        "evidence": {
          "oneOf": [
            {"$ref": "#/$defs/prepareEvidence"},
            {"$ref": "#/$defs/commitEvidence"},
            {"$ref": "#/$defs/cancelEvidence"}
          ]
        }
      }
    },
    "prepareEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_id", "credential_fingerprint", "ready"],
      "properties": {
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "credential_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "ready": {"const": true}
      }
    },
    "commitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_id", "credential_fingerprint", "activated"],
      "properties": {
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "credential_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "activated": {"const": true}
      }
    },
    "cancelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_id", "cancelled"],
      "properties": {
        "rotation_id": {"$ref": "#/$defs/uuid"},
        "cancelled": {"const": true}
      }
    }
  }
}
